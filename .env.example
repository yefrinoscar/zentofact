# Neon Postgres — primary database.
DATABASE_URL_POSTGRES=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require&channel_binding=require
# Cloudflare R2 — stores XML/CDR legal archives. If unset, they fall back to local disk.
# (PDFs always stay local and are regenerated on demand.)
# Direct S3 endpoint (only works if the network reaches *.r2.cloudflarestorage.com):
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=boletas-sunat
# R2 via Worker proxy (use when the network blocks the direct R2 endpoint). Takes priority.
R2_PROXY_URL=https://boletas-r2-proxy.<tu-subdominio>.workers.dev
R2_PROXY_SECRET=
# Falabella Seller API
FALABELLA_API_URL=https://sellercenter-api.falabella.com/
FALABELLA_API_VERSION=1.0
FALABELLA_API_USER_ID=
FALABELLA_API_KEY=
