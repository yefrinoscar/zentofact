# Neon Postgres — primary database.
DATABASE_URL_POSTGRES=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require&channel_binding=require

# Catálogo e inventario. Desplegar primero con el hook apagado, importar
# listings/stock inicial y activarlo después de validar re-sync en staging.
CATALOG_INVENTORY_ENABLED=false
CATALOG_ALLOW_NEGATIVE_MARKETPLACE=false
CATALOG_ALLOW_NEGATIVE_MANUAL=false
# Publicar/despublicar Falabella. Déjalo apagado: el catálogo solo simula
# el flujo y POST /falabella/:companyId/products no llama al Seller API.
MARKETPLACE_PUBLICATION_MUTATION_ENABLED=false
# Autenticación. Genera BETTER_AUTH_SECRET con un gestor de secretos.
BETTER_AUTH_SECRET=
AUTH_BASE_URL=https://api.example.com
WEB_ORIGINS=https://app.example.com
# Resend — forgot password. Sin dominio: usa onboarding@resend.dev
# (solo envía al email de la cuenta Resend hasta verificar un dominio).
# Si falta RESEND_API_KEY, el link de reset se imprime en los logs del server.
RESEND_API_KEY=
RESEND_FROM_EMAIL=ZentoFact <onboarding@resend.dev>
# Promueve explícitamente un usuario activo existente a superadmin. Déjalo vacío
# después del bootstrap; nunca hay promoción automática del usuario más antiguo.
AUTH_SUPERADMIN_EMAIL=
# Solo para `npm run auth:seed-admin` y seeds de preview; no existen valores por defecto en prod.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Password compartido para usuarios demo del seed (operator/vendedor/billing). Si falta, usa ADMIN_PASSWORD.
SEED_USER_PASSWORD=
# Seed demo: en PR previews de Railway corre solo. En local/staging: `true` lo fuerza.
# Para no crear NADA en un PR (ni auth ni datos): SEED_PREVIEW=false  o  SKIP_PREVIEW_SEED=true
SEED_PREVIEW=
SKIP_PREVIEW_SEED=
# Obligatorio en producción para el webhook de Falabella.
AUTO_EMIT_WEBHOOK_SECRET=
# Aviso si un comprobante no se emite tras 3 intentos. Lista separada por comas.
# Si falta, se avisa a usuarios con permiso de boletas (o ADMIN_EMAIL).
AUTO_EMIT_ALERT_EMAIL=
# Cloudflare R2 — stores XML/CDR legal archives. If unset, they fall back to local disk.
# (PDFs always stay local and are regenerated on demand.)
# Direct S3 endpoint (only works if the network reaches *.r2.cloudflarestorage.com):
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=boletas-sunat
# R2 via Worker proxy (use when the network blocks the direct R2 endpoint). Takes priority.
R2_PROXY_URL=https://boletas-r2-proxy.<tu-subdominio>.workers.dev
R2_PROXY_SECRET=
# Falabella Seller API
FALABELLA_API_URL=https://sellercenter-api.falabella.com/
FALABELLA_API_VERSION=1.0
FALABELLA_API_USER_ID=
FALABELLA_API_KEY=

# Ripley Perú Mirakl. La documentación peruana sólo publica el tenant productivo.
RIPLEY_API_URL=https://ripleyperu-prod.mirakl.net

# SUNAT environment. Use prod for real emission; set beta only for explicit tests.
SUNAT_FORCE_ENV=prod
VITE_SUNAT_ENV=prod
# Google Maps — Places y Maps JavaScript. Restringe la key a tus orígenes web.
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Set to production only on the Railway production web service.
# Hides Productos and Todos los pedidos. Leave as development everywhere else.
VITE_APP_ENV=development
