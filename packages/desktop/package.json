{
  "name": "@zentofact/desktop",
  "version": "1.0.0",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "generate-icons": "node scripts/generate-icons.js",
    "prepare-puppeteer-browser": "node scripts/prepare-puppeteer-browser.js",
    "prepare-playwright-browsers": "node scripts/prepare-playwright-browsers.js",
    "build:deps": "npm run build -w @zentofact/core && npm run build -w @zentofact/falabella-api && npm run build -w @zentofact/scraper",
    "package": "npm run generate-icons && npm run build:deps && electron-vite build && electron-builder --mac --win --linux",
    "package:mac": "npm run dmg",
    "dmg": "npm run generate-icons && npm run build:deps && electron-vite build && electron-builder --mac dmg"
  },
  "dependencies": {
    "@zentofact/core": "*",
    "@zentofact/falabella-api": "*",
    "@zentofact/scraper": "*",
    "@zentofact/web": "*",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-select": "^2.2.6",
    "@tanstack/react-query": "^5.100.9",
    "@xyflow/react": "^12.10.2",
    "better-auth": "^1.6.23",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.0",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.75.0",
    "react-router-dom": "^7.15.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.0",
    "electron": "33.4.11",
    "electron-builder": "^25.0.0",
    "electron-vite": "^5.0.0",
    "postcss": "^8.5.14",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.8.0"
  },
  "build": {
    "appId": "com.zentofact.app",
    "productName": "ZentoFact",
    "icon": "resources/icon.png",
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "../../.env",
        "to": ".env"
      },
      {
        "from": "resources",
        "to": "resources"
      },
      {
        "from": "storage",
        "to": "storage-seed"
      }
    ],
    "mac": {
      "target": "dmg",
      "icon": "resources/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "resources/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "resources/icon.png"
    }
  }
}
